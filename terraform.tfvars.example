github_repositories = [
  "libops/sitectl",
  "libops/sitectl-app-tmpl",
  "libops/sitectl-archivesspace",
  "libops/sitectl-drupal",
  "libops/sitectl-isle",
  "libops/sitectl-libops",
  "libops/sitectl-ojs",
  "libops/sitectl-omeka-classic",
  "libops/sitectl-omeka-s",
  "libops/sitectl-wp",
]

# LibOps-owned publishers follow managed channels. GitHub resolves each run to
# an exact workflow commit, which the credentialed job records as evidence.
approved_job_workflow_refs = [
  "libops/terraform-linux-packages/.github/workflows/reusable-goreleaser.yaml@refs/heads/main",
  "libops/.github/.github/workflows/sitectl-plugin-goreleaser.yaml@refs/heads/main",
]

github_actors = [
  "joe",
]

package_domain    = "packages.libops.io"
dns_zone_name     = "packages-libops-io"
dns_zone_dns_name = "packages.libops.io."
bucket_name       = "libops-linux-packages"
aptly_gpg_key_id  = "YOUR-APTLY-GPG-KEY-ID"
